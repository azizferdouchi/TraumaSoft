{
    "name": "traumasoft/api",
    "description": "API REST pour la gestion d'un cabinet de traumatologie avec intégration IA",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "traumatologie",
        "medecine",
        "gestion",
        "cabinet",
        "api",
        "rest",
        "ia",
        "artificial intelligence"
    ],
    "authors": [
        {
            "name": "TraumaSoft Team",
            "email": "contact@traumasoft.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "firebase/php-jwt": "^6.0",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "TraumaSoft\\": "backend/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TraumaSoft\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse backend --level=5",
        "serve": "php -S localhost:8000 -t backend",
        "db:import": "php database/import_database.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
